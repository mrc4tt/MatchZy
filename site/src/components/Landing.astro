---
// The landing page (index.mdx and da/index.mdx). All numbers come from the plugin source at build
// time (src/data/plugin.ts), so they match the release this site was built from.
import { version, stats, repo, download } from '../data/plugin';

interface Props { lang?: 'en' | 'da' }
const { lang = 'en' } = Astro.props;
const base = lang === 'da' ? '/da/' : '/';

const t = {
	en: {
		badge: 'Latest release',
		h1a: 'Run CS2 matches',
		h1b: 'without the hassle.',
		lead: 'Match management, practice mode, coaching, live events and stats for CS2 servers running CounterStrikeSharp. Built on MatchZy, extended for hosted competitive servers.',
		download: 'Download', start: 'Get started', commands: 'Commands',
		small: [['Changelog', 'changelog/'], ['All releases', `${repo}/releases`], ['Report an issue', `${repo}/issues`]],
		stats: ['chat commands', 'settings', 'event types', 'languages'],
		featTitle: 'Everything a match server needs',
		featLead: 'From a five-minute pug to a league with 2v2 to 5v5 brackets.',
		feats: [
			['trophy', 'Matches your way', 'Pugs with a ready check, Get5-style match configs with veto and BO1 to BO5, scrim and hill modes, players vs bots, or an in-game setup wizard.', 'guides/match-setup/'],
			['users', '5v5, wingman, rush and 1v1', 'Every team size from one command or one match config key. Team size, ready count and live cfg follow the mode.', 'guides/game-modes/'],
			['bracket', 'Tournament ready', 'Leagues without an admin: the team size comes from the match config, one .ready per team starts it, and the server names who a team is waiting for.', 'guides/ready-system/#tournaments'],
			['target', 'Serious practice mode', 'Grenade history and rethrow, a grenade library with in-world markers, bots that shoot back, path recording and whole-team strategy replays.', 'guides/practice/'],
			['whistle', 'Coaching that works', 'Coaches set in the match config, a viewing spot behind the team on every map, and players who never notice a coach is there.', 'guides/coaching/'],
			['signal', 'Live events', 'Webhooks for every kill, damage, bomb, grenade, pause and round. Build scoreboards, Discord bots or overlays.', 'guides/events/'],
			['chart', 'Stats', 'SQLite or MySQL, CSV export, and an HLTV-style scoreboard with rating, KAST, opening duels and clutches.', 'guides/stats/'],
			['shield', 'Built for hosting', 'Reliable demo recording and upload, round restores after a crash, admin tickets, safe config updates and coexistence with CS2-SimpleAdmin.', 'getting-started/installation/'],
		],
		qsTitle: 'Up in four steps',
		qs: [
			['Install CounterStrikeSharp', 'on your CS2 server.'],
			['Extract the zip', `MatchZy-${version}.zip into game/csgo/.`],
			['Restart the server', 'cfg/MatchZy/config.cfg is written with every setting and its default.'],
			['Play', 'In game as admin: .match, then the players type .ready.'],
		],
		qsMore: 'Full steps in Installation',
		tourTitle: 'Load a match from your panel',
		tourLead: 'Get5-compatible match configs by URL or file. The server checks them as they load and tells you what would keep a match from starting.',
		tourPoints: ['Team size from the rosters, substitutes allowed', 'One .ready per team with matchzy_ready_per_team 1', 'matchzy_validate_match checks a config before you send it'],
		tourCta: 'Build a match config',
		credits: 'Based on MatchZy by Shobhit Pathak. Maintained by Miksen. Command names and the match config format are unchanged, so existing guides and Get5 panels keep working.',
		panel: { warm: 'WARMUP', title: 'READY UP TO START', mode: 'Mode: Competitive', ready: 'Ready (min. 4):', you: '✔ You are READY', short: '3 joined (min. 4): missing alpha4', wait: 'Waiting on: playerA, playerB' },
	},
	da: {
		badge: 'Seneste udgivelse',
		h1a: 'Kør CS2-kampe',
		h1b: 'uden besvær.',
		lead: 'Kampstyring, practice mode, coaching, live events og statistik til CS2-servere med CounterStrikeSharp. Bygget på MatchZy, udvidet til hostede konkurrence-servere.',
		download: 'Download', start: 'Kom i gang', commands: 'Kommandoer',
		small: [['Changelog', 'changelog/'], ['Alle udgivelser', `${repo}/releases`], ['Rapportér en fejl', `${repo}/issues`]],
		stats: ['chatkommandoer', 'indstillinger', 'event-typer', 'sprog'],
		featTitle: 'Alt hvad en kampserver skal bruge',
		featLead: 'Fra en hurtig pug til en liga med 2v2- til 5v5-turneringer.',
		feats: [
			['trophy', 'Kampe på din måde', 'Pugs med ready check, Get5-match configs med veto og BO1 til BO5, scrim- og hill-modes, spillere mod bots eller en setup-guide i spillet.', 'guides/match-setup/'],
			['users', '5v5, wingman, rush og 1v1', 'Alle holdstørrelser fra én kommando eller én nøgle i match configen. Holdstørrelse, ready-antal og live-cfg følger mode.', 'guides/game-modes/'],
			['bracket', 'Klar til turneringer', 'Ligaer uden admin: holdstørrelsen kommer fra match configen, én .ready pr. hold starter kampen, og serveren viser, hvem et hold venter på.', 'guides/ready-system/#tournaments'],
			['target', 'Seriøs practice mode', 'Granathistorik og rethrow, et granatbibliotek med markører i verden, bots der skyder igen, path recording og strategi-replays for hele holdet.', 'guides/practice/'],
			['whistle', 'Coaching der virker', 'Coaches sat i match configen, en udsigtsplads bag holdet på hver bane, og spillere der aldrig mærker, at en coach er der.', 'guides/coaching/'],
			['signal', 'Live events', 'Webhooks for hvert kill, skade, bombe, granat, pause og runde. Byg scoreboards, Discord-bots eller overlays.', 'guides/events/'],
			['chart', 'Statistik', 'SQLite eller MySQL, CSV-eksport og et HLTV-agtigt scoreboard med rating, KAST, opening duels og clutches.', 'guides/stats/'],
			['shield', 'Bygget til hosting', 'Pålidelig demo-optagelse og upload, gendannelse af runder efter et crash, admin-tickets, sikre config-opdateringer og sameksistens med CS2-SimpleAdmin.', 'getting-started/installation/'],
		],
		qsTitle: 'Oppe at køre i fire trin',
		qs: [
			['Installér CounterStrikeSharp', 'på din CS2-server.'],
			['Pak zip-filen ud', `MatchZy-${version}.zip i game/csgo/.`],
			['Genstart serveren', 'cfg/MatchZy/config.cfg skrives med alle indstillinger og deres standard.'],
			['Spil', 'I spillet som admin: .match, og spillerne skriver .ready.'],
		],
		qsMore: 'Alle trin i Installation',
		tourTitle: 'Load en kamp fra jeres panel',
		tourLead: 'Get5-kompatible match configs fra URL eller fil. Serveren tjekker dem, når de loades, og fortæller, hvad der ville forhindre kampen i at starte.',
		tourPoints: ['Holdstørrelse fra rosters, reserver tilladt', 'Én .ready pr. hold med matchzy_ready_per_team 1', 'matchzy_validate_match tjekker en config, før I sender den'],
		tourCta: 'Byg en match config',
		credits: 'Baseret på MatchZy af Shobhit Pathak. Vedligeholdt af Miksen. Kommandonavne og match config-formatet er uændrede, så eksisterende guides og Get5-paneler virker stadig.',
		panel: { warm: 'WARMUP', title: 'READY UP TO START', mode: 'Mode: Competitive', ready: 'Ready (min. 4):', you: '✔ You are READY', short: '3 joined (min. 4): missing alpha4', wait: 'Waiting on: playerA, playerB' },
	},
}[lang];

const statValues = [stats.commands, stats.settings, stats.events, stats.languages];
const href = (p: string) => (p.startsWith('http') ? p : base + p);

// Small line icons (24px grid, stroke), one per feature.
const icons: Record<string, string> = {
	trophy: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3',
	users: 'M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6M22 19v-1a4 4 0 0 0-3-3.9M16 4.1a3 3 0 0 1 0 5.8',
	bracket: 'M3 5h5v4H3zM3 15h5v4H3zM8 7h3v10H8M11 12h4M15 10h6v4h-6z',
	target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 3v3M12 18v3M3 12h3M18 12h3',
	whistle: 'M9 8h11l-2 5a6 6 0 1 1-9-5ZM9 8V5h4M11 14h.01',
	signal: 'M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM8.5 8.5a5 5 0 0 0 0 7M15.5 15.5a5 5 0 0 0 0-7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 18.4a9 9 0 0 0 0-12.8',
	chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
	shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10ZM9 12l2 2 4-4',
};
---

<div class="mz-landing not-content" lang={lang} data-mz-built={version}>
	<section class="mz-hero">
		<div class="mz-hero__text">
			<a class="mz-badge" href={href('whats-new/')}><span class="mz-dot"></span>{t.badge} <strong data-mz-version>{version}</strong></a>
			<h1 class="mz-h1">{t.h1a}<br /><span>{t.h1b}</span></h1>
			<p class="mz-lead">{t.lead}</p>
			<div class="mz-actions">
				<a class="mz-btn mz-btn--primary" href={download} data-mz-download>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
					{t.download} <span data-mz-version>{version}</span>
				</a>
				<a class="mz-btn" href={href('getting-started/installation/')}>{t.start}</a>
				<a class="mz-btn" href={href('reference/commands/')}>{t.commands}</a>
			</div>
			<p class="mz-small">{t.small.map(([label, p], i) => <>{i > 0 && ' · '}<a href={href(p)}>{label}</a></>)}</p>
		</div>
		<div class="mz-hero__panel" aria-hidden="true">
			<div class="mz-glow"></div>
			<div class="mz-panel">
				<div class="mz-p-warm">● {t.panel.warm}</div>
				<div class="mz-p-title">{t.panel.title}</div>
				<div class="mz-p-mode">{t.panel.mode}</div>
				{/* Progress, not a player count: 5 of the 8 needed (CT 2 + T 3 of min. 4 per side). The
				     in-game panel draws the same ratio as 12 blocks, which read like 12 player slots. */}
				<div class="mz-p-bar" style="--fill: 62.5%"><i></i></div>
				<div class="mz-p-sides">{t.panel.ready} <span class="ct">CT 2</span> <span class="tt">T 3</span></div>
				<div class="mz-p-you">{t.panel.you}</div>
				<div class="mz-p-short">{t.panel.short}</div>
				<div class="mz-p-wait">{t.panel.wait}</div>
			</div>
			<code class="mz-caption">matchzy_ready_hint_style 1</code>
		</div>
	</section>

	<section class="mz-stats">
		{statValues.map((n, i) => <div><b>{n}</b><span>{t.stats[i]}</span></div>)}
	</section>

	<section class="mz-section">
		<h2 class="mz-h2">{t.featTitle}</h2>
		<p class="mz-sublead">{t.featLead}</p>
		<div class="mz-feats">
			{t.feats.map(([icon, title, text, link]) => (
				<a class="mz-feat" href={href(link)}>
					<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d={icons[icon]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
					<h3>{title}</h3>
					<p>{text}</p>
					<span class="mz-arrow">→</span>
				</a>
			))}
		</div>
	</section>

	<section class="mz-section mz-split">
		<div>
			<h2 class="mz-h2">{t.tourTitle}</h2>
			<p class="mz-sublead">{t.tourLead}</p>
			<ul class="mz-checks">{t.tourPoints.map((p) => <li>{p}</li>)}</ul>
			<a class="mz-btn mz-btn--primary" href={href('reference/match-builder/')}>{t.tourCta} →</a>
		</div>
		<pre class="mz-code" aria-label="match.json"><code><span class="c">// matchzy_loadmatch_url "https://panel/match.json"</span>
{'{'}
  <span class="k">"matchid"</span>: <span class="n">39509</span>,
  <span class="k">"num_maps"</span>: <span class="n">1</span>,
  <span class="k">"maplist"</span>: [<span class="s">"de_inferno"</span>],
  <span class="k">"players_per_team"</span>: <span class="n">4</span>,
  <span class="k">"team1"</span>: {'{'} <span class="k">"name"</span>: <span class="s">"Team A"</span>, <span class="k">"players"</span>: {'{'} ... {'}'} {'}'},
  <span class="k">"team2"</span>: {'{'} <span class="k">"name"</span>: <span class="s">"Team B"</span>, <span class="k">"players"</span>: {'{'} ... {'}'} {'}'}
{'}'}</code></pre>
	</section>

	<section class="mz-section">
		<h2 class="mz-h2">{t.qsTitle}</h2>
		<ol class="mz-steps" data-mz-version-text>
			{t.qs.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}
		</ol>
		<p><a href={href('getting-started/installation/')}>{t.qsMore} →</a></p>
	</section>

	<p class="mz-credits">{t.credits}</p>
</div>

<style>
	/* Landing page only. Starlight's splash template keeps the header; the content is ours. */
	.mz-landing { --gap: clamp(3rem, 7vw, 6rem); padding-bottom: 3rem; }
	.mz-landing a { text-decoration: none; }
	.mz-hero {
		display: grid; gap: 3rem; align-items: center; padding: clamp(1.5rem, 5vw, 4rem) 0 var(--gap);
		grid-template-columns: minmax(0, 1fr);
	}
	@media (min-width: 60rem) { .mz-hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
	.mz-badge {
		display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.85rem; border-radius: 2rem;
		font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); background: var(--mz-surface); border: 1px solid var(--mz-line);
	}
	.mz-badge strong { color: var(--sl-color-white); }
	.mz-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--mz-green); box-shadow: 0 0 10px var(--mz-green); }
	.mz-h1 {
		margin: 1.2rem 0 1rem; font-size: clamp(2.6rem, 6.5vw, 4.6rem); line-height: 1.02; font-weight: 850;
		letter-spacing: -0.045em; color: var(--sl-color-white);
	}
	.mz-h1 span { background: var(--mz-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
	.mz-lead { font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; color: var(--sl-color-gray-2); max-width: 38rem; margin: 0 0 1.8rem; }
	.mz-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
	.mz-small { margin-top: 1.2rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.mz-small a { color: var(--sl-color-gray-3); }
	.mz-small a:hover { color: var(--sl-color-accent); }

	/* The in-game ready panel */
	.mz-hero__panel { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.8rem; overflow: clip; padding: 2rem 0; }
	.mz-glow { position: absolute; inset: 15% 10%; background: radial-gradient(closest-side, color-mix(in srgb, var(--mz-orange) 35%, transparent), transparent); filter: blur(30px); }
	.mz-panel {
		position: relative; width: min(100%, 24rem); padding: 1.6rem 1.4rem; border-radius: 1rem; text-align: center;
		font-size: 0.95rem; line-height: 1.55; color: #e8e8e8; background: linear-gradient(180deg, #23262c, #17191d);
		border: 1px solid #343842; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
		transform: perspective(900px) rotateY(-8deg) rotateX(3deg); transition: transform 0.4s;
	}
	.mz-panel:hover { transform: none; }
	.mz-p-warm { color: var(--mz-orange); font-weight: 800; letter-spacing: 0.04em; }
	.mz-p-title { color: #ffd23f; font-weight: 800; }
	.mz-p-mode { color: #d6d6d6; }
	.mz-p-bar { width: min(15rem, 100%); height: 0.5rem; margin: 0.6rem auto; border-radius: 999px; background: #3b3f47; overflow: hidden; }
	.mz-p-bar i { display: block; width: var(--fill); height: 100%; border-radius: inherit; background: var(--mz-green); animation: mz-grow 1.1s ease-out 0.3s backwards; }
	@keyframes mz-grow { from { width: 0; } }
	.mz-p-sides .ct { color: var(--mz-ct); }
	.mz-p-sides .tt { color: var(--mz-t); }
	.mz-p-you { color: var(--mz-green); font-weight: 800; margin-top: 0.3rem; }
	.mz-p-short { color: #ffd23f; font-size: 0.9rem; }
	.mz-p-wait { color: #9da3ad; font-size: 0.9rem; }
	.mz-caption { position: relative; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); background: none; border: 0; }
	@media (prefers-reduced-motion: reduce) { .mz-panel { transform: none; } .mz-p-bar i { animation: none; } }

	/* Numbers */
	.mz-stats { display: grid; gap: 0.8rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	@media (min-width: 45rem) { .mz-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	.mz-stats div { display: flex; flex-direction: column; align-items: center; padding: 1.3rem 0.5rem; border-radius: 1rem; background: var(--mz-surface); border: 1px solid var(--mz-line); }
	.mz-stats b { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 850; letter-spacing: -0.04em; line-height: 1; background: var(--mz-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
	.mz-stats span { margin-top: 0.4rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }

	/* Sections */
	.mz-section { margin-top: var(--gap); }
	.mz-h2 { margin: 0 0 0.5rem; font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; color: var(--sl-color-white); }
	.mz-sublead { margin: 0 0 1.8rem; color: var(--sl-color-gray-2); font-size: 1.05rem; max-width: 40rem; }

	.mz-feats { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
	@media (min-width: 40rem) { .mz-feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (min-width: 72rem) { .mz-feats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	.mz-feat {
		position: relative; display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem 1.3rem 2.6rem; border-radius: 1rem;
		background: var(--mz-surface); border: 1px solid var(--mz-line); color: var(--sl-color-gray-2);
		transition: transform 0.18s, border-color 0.18s, background 0.18s;
	}
	.mz-feat:hover { transform: translateY(-3px); border-color: var(--mz-orange); background: var(--mz-surface-2); }
	.mz-feat svg { color: var(--mz-orange); }
	.mz-feat h3 { margin: 0.3rem 0 0; font-size: 1.05rem; font-weight: 700; color: var(--sl-color-white); }
	.mz-feat p { margin: 0; font-size: var(--sl-text-sm); line-height: 1.6; }
	.mz-arrow { position: absolute; left: 1.3rem; bottom: 1rem; color: var(--mz-orange); transition: transform 0.18s; }
	.mz-feat:hover .mz-arrow { transform: translateX(4px); }

	.mz-split { display: grid; gap: 2rem; align-items: center; grid-template-columns: minmax(0, 1fr); }
	@media (min-width: 60rem) { .mz-split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
	.mz-checks { list-style: none; padding: 0; margin: 0 0 1.8rem; display: grid; gap: 0.6rem; }
	.mz-checks li { position: relative; padding-left: 1.8rem; color: var(--sl-color-gray-1); }
	.mz-checks li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 1.2rem; height: 1.2rem; display: grid; place-items: center; border-radius: 50%; font-size: 0.75rem; font-weight: 900; color: #1a0f05; background: var(--mz-orange); }
	.mz-code {
		margin: 0; padding: 1.4rem 1.5rem; border-radius: 1rem; overflow-x: auto; font-size: 0.85rem; line-height: 1.7;
		font-family: var(--sl-font-mono); color: #d8dbe2; background: #121316; border: 1px solid #2c2f36;
	}
	.mz-code .c { color: #6b717c; } .mz-code .k { color: #ffb36b; } .mz-code .s { color: #9ecbff; } .mz-code .n { color: var(--mz-green); }

	.mz-steps { list-style: none; counter-reset: s; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
	@media (min-width: 50rem) { .mz-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	.mz-steps li { counter-increment: s; display: flex; flex-direction: column; gap: 0.3rem; padding: 1.2rem; border-radius: 1rem; background: var(--mz-surface); border: 1px solid var(--mz-line); color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.mz-steps li::before { content: counter(s); width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; font-weight: 850; color: #1a0f05; background: var(--mz-grad); margin-bottom: 0.4rem; }
	.mz-steps strong { color: var(--sl-color-white); font-size: 1rem; }

	.mz-credits { margin-top: var(--gap); padding-top: 1.5rem; border-top: 1px solid var(--mz-line); font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>

<script>
	import { checkRelease } from '../scripts/release-check.js';
	checkRelease();
</script>
