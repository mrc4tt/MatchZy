---
// Starlight's Markdown wrapper plus the Mermaid renderer. The library is only fetched on pages that
// have a diagram (remarkMermaid in src/plugins/remark-docs.mjs), and redrawn when the theme changes.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
---

<Default><slot /></Default>

<script>
	const blocks = [...document.querySelectorAll<HTMLElement>('pre.mermaid')];
	if (blocks.length) {
		for (const b of blocks) b.dataset.src = b.textContent ?? '';
		const { default: mermaid } = await import('mermaid');
		const draw = async () => {
			const dark = document.documentElement.dataset.theme !== 'light';
			mermaid.initialize({
				startOnLoad: false,
				theme: 'base',
				fontFamily: 'Inter Variable, system-ui, sans-serif',
				themeVariables: dark
					? { darkMode: true, background: '#121316', primaryColor: '#22252b', primaryTextColor: '#f5f6f8', primaryBorderColor: '#ff8a1f', lineColor: '#8b909a', secondaryColor: '#1a1c21', tertiaryColor: '#1a1c21', actorBkg: '#22252b', actorBorder: '#ff8a1f', actorTextColor: '#f5f6f8', signalColor: '#bcc0c9', signalTextColor: '#e3e5ea', noteBkgColor: '#3a1d06', noteTextColor: '#ffd2a6' }
					: { background: '#ffffff', primaryColor: '#fff4ea', primaryTextColor: '#15171b', primaryBorderColor: '#c2500a', lineColor: '#5d626c', secondaryColor: '#f6f7f9', tertiaryColor: '#f6f7f9', actorBkg: '#fff4ea', actorBorder: '#c2500a', actorTextColor: '#15171b', signalColor: '#3a3e46', signalTextColor: '#23262c', noteBkgColor: '#ffe6cf', noteTextColor: '#6b2a03' },
			});
			for (const b of blocks) {
				b.removeAttribute('data-processed');
				b.textContent = b.dataset.src ?? '';
			}
			await mermaid.run({ nodes: blocks });
		};
		await draw();
		new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	}
</script>

<style is:global>
	pre.mermaid {
		display: flex;
		justify-content: center;
		margin-block: 1.5rem;
		padding: 1rem;
		overflow-x: auto;
		border: 1px solid var(--mz-line);
		border-radius: 0.75rem;
		background: var(--mz-surface);
		font-family: var(--sl-font);
	}
	pre.mermaid:not([data-processed]) { color: transparent; min-height: 8rem; }
</style>
